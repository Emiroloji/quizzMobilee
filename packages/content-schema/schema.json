{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soruhavuzu.app/content/v1.json",
  "title": "SoruHavuzu blok-JSON içerik şeması v1",
  "$defs": {
    "Content": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "number",
          "const": 1
        },
        "blocks": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "t": {
                    "type": "string",
                    "const": "p"
                  },
                  "c": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "t": {
                              "type": "string",
                              "const": "text"
                            },
                            "v": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 5000
                            }
                          },
                          "required": [
                            "t",
                            "v"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "t": {
                              "type": "string",
                              "const": "math"
                            },
                            "v": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000
                            }
                          },
                          "required": [
                            "t",
                            "v"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "t",
                  "c"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "t": {
                    "type": "string",
                    "const": "math_block"
                  },
                  "v": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "t",
                  "v"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "t": {
                    "type": "string",
                    "const": "image"
                  },
                  "asset_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "t",
                  "asset_id",
                  "alt"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "schema",
        "blocks"
      ],
      "additionalProperties": false
    },
    "AnswerSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mcq"
            },
            "options": {
              "minItems": 2,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "D",
                      "E"
                    ]
                  },
                  "body": {
                    "$ref": "#/$defs/Content"
                  }
                },
                "required": [
                  "id",
                  "body"
                ],
                "additionalProperties": false
              }
            },
            "correct": {
              "minItems": 1,
              "maxItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              }
            },
            "shuffle": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "options",
            "correct",
            "shuffle"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
