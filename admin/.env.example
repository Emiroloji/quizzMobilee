# Kopyalayıp .env.local yapın. VITE_* değerleri pakete gömülür; gizli bilgi koymayın.
VITE_API_URL=http://localhost:8080
# dev: backend local profilindeki sahte JWT üretici · oidc: Logto (ADR 0024)
VITE_AUTH_MODE=dev
VITE_OIDC_ISSUER=http://localhost:3001/oidc
VITE_OIDC_CLIENT_ID=
VITE_API_RESOURCE=http://localhost:8080
VITE_ASSET_BASE_URL=http://localhost:8333/soruhavuzu-media-local
