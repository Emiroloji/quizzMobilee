# Kopyalayıp .env.local yapın. VITE_* değerleri pakete gömülür; gizli bilgi koymayın.
VITE_API_URL=http://localhost:8080
# dev: backend local profilindeki sahte JWT üretici · cognito: Cognito managed login
VITE_AUTH_MODE=dev
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_ASSET_BASE_URL=http://localhost:4566/soruhavuzu-media-local
