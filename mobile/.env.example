# Kopyalayıp .env.local yapın. EXPO_PUBLIC_* değerleri uygulamaya gömülür; gizli bilgi koymayın.
# Android emülatöründe localhost yerine 10.0.2.2, fiziksel cihazda bilgisayarın yerel IP'si kullanılır.
EXPO_PUBLIC_API_URL=http://localhost:8080
# dev: backend local profilindeki sahte JWT üretici · oidc: Logto (ADR 0024)
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:3001/oidc
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_API_RESOURCE=http://localhost:8080
EXPO_PUBLIC_ASSET_BASE_URL=http://localhost:8333/soruhavuzu-media-local
