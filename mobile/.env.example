# Kopyalayıp .env.local yapın. EXPO_PUBLIC_* değerleri uygulamaya gömülür; gizli bilgi koymayın.
# Android emülatöründe localhost yerine 10.0.2.2, fiziksel cihazda bilgisayarın yerel IP'si kullanılır.
EXPO_PUBLIC_API_URL=http://localhost:8080
# dev: backend local profilindeki sahte JWT üretici · cognito: Cognito managed login (Apple/Google/e-posta)
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_ASSET_BASE_URL=http://localhost:4566/soruhavuzu-media-local
