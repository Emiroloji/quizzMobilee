    "sinh", "cosh", "tanh", "deg", "det", "gcd", "mod", "bmod", "pmod",

    "leq", "geq", "neq", "le", "ge", "ne", "approx", "equiv", "sim", "simeq", "cong", "propto",
    "lt", "gt", "ll", "gg", "subset", "subseteq", "supset", "supseteq", "nsubseteq",
    "in", "notin", "ni", "cup", "cap", "emptyset", "varnothing", "setminus", "complement",
    "forall", "exists", "nexists", "mid", "nmid", "parallel", "perp", "angle", "measuredangle", "triangle", "square", "circ",
    "to", "rightarrow", "leftarrow", "leftrightarrow", "Rightarrow", "Leftarrow", "Leftrightarrow",
